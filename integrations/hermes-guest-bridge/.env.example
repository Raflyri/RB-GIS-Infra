# ==============================================================================
# Konfigurasi Hermes GIS Guest Bridge untuk CT 101 (hermes-agent - 10.10.10.167)
# Salin menjadi .env di /opt/hermes-guest-bridge/.env dan chmod 600
# ==============================================================================

# Alamat privat FastAPI Backend GIS (CT 400) melalui MikroTik ZeroTier Tunnel
GIS_INTERNAL_API_URL=http://172.16.10.130:8000
ALLOWED_GIS_BACKEND_IP=172.16.10.130

# Listening port bridge webhook di CT 101
BRIDGE_HOST=0.0.0.0
BRIDGE_PORT=8787

# Shared secret 64-hex (HARUS SAMA PERSIS dengan HERMES_SHARED_SECRET di CT 400 Backend)
HERMES_SHARED_SECRET=<generate-64-hex-chars>

# Nomor WhatsApp resmi Owner (format internasional tanpa +, mis. 6281385120136)
ALLOWED_OWNER_WA_NUMBER=6281385120136

# Adapter pengiriman pesan WhatsApp Hermes di CT 101 (pilih salah satu sesuai bridge aktif)
HERMES_WA_BRIDGE_URL=http://127.0.0.1:3000/send
HERMES_WA_WEBHOOK_URL=
HERMES_WA_SEND_CMD=

# Fallback recovery loop jika CT 101 sempat offline/reboot
ENABLE_RECOVERY_LOOP=true
RECOVERY_POLL_SECONDS=30
LOG_LEVEL=INFO
